# Local data — never committed
*.pkl
data/

# Weights are shipped to the host out of band (scp), not through git: a 46MB
# blob per retrain bloats history fast, and artifact_url/artifact_sha256 are not
# required manifest fields (MIN_REQUIRED_MANIFEST_FIELDS) nor checked by
# evaluate_manifest_suspicion. This matches every scoring miner on the subnet --
# none of them track weights. meta.json IS tracked, so the schema hash, version
# and policy report of each build stay in history.
*.joblib

# Private training pipeline
detector/train.py

# Secrets
.env

# Caches, builds, scratch
__pycache__/
*.pyc
.venv/
dist/
build/
*.egg-info/
*.log
_feature_cache.npz
catboost_info/

# Live validator-query captures (diagnostic, local-only, never leaves the box)
live_capture/
