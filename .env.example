# Copy to .env and fill in. .env is gitignored -- never commit wallet details.
POKER44_WALLET_NAME=
POKER44_WALLET_HOTKEY=
POKER44_NETUID=126
POKER44_AXON_PORT=8091

# Public repo hosting this miner (published in the model manifest).
POKER44_MODEL_REPO_URL=

# --- Model manifest -------------------------------------------------------
# REQUIRED. The validator runs evaluate_manifest_suspicion() on every response
# and records a flag when repo_url is empty (reason: manifest_missing_repo_url),
# alongside missing repo_commit / training_data_statement /
# private_data_attestation and open_source=false. Those flags are persisted to a
# per-UID suspicion registry and published in the validator's observability
# payloads. Leaving this blank gets you flagged on EVERY forward pass.
# POKER44_MODEL_REPO_URL=https://github.com/<you>/<this-repo>

# --- Live validator-query capture (diagnostic) ----------------------------
# OFF by default. Persists the UNLABELED chunks validators send, so the
# benchmark->live distribution gap can be measured locally. Inputs only: a live
# query carries no ground-truth label, so nothing captured can be a supervised
# training label. Output goes to live_capture/ which is gitignored.
#
# ATTESTATION: capturing for DIAGNOSIS does not change your manifest. If you ever
# feed captures into training -- even unlabeled, for domain adaptation -- the
# strings in neurons/miner.py ("Trained only on the public Poker44 benchmark." /
# "No validator-only data is used.") become FALSE and must be updated before you
# serve again.
# POKER44_CAPTURE=1
# POKER44_CAPTURE_BATCH=1
# POKER44_CAPTURE_DIR=./live_capture
# POKER44_CAPTURE_MAX_BYTES=262144000

# --- Feature / serving toggles (A-B switches, all default ON) -------------
# POKER44_SCALE_NORM=0        # raw bb magnitudes instead of pot-relative ratios
# POKER44_DRIFT_POLICY=0      # keep drift-prone feature families
# POKER44_MAX_POS_FRAC=0.05   # cap on the fraction scored >= 0.5 (v4)
# POKER44_POSITIVE_FRACTION=0.05  # fraction placed >= 0.5 (v5)
